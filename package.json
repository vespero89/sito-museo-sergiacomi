{
  "name": "sito-museo-sergiacomi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Website of the Museo Aldo Sergiacomi (LaDiMAS), prototype.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/emit-hosting.mjs",
    "build:production": "export SITE_ENV=production && astro build && pagefind --site dist && node scripts/emit-hosting.mjs",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "serve": "node scripts/serve-dist.mjs",
    "content:check": "node scripts/content-check.mjs",
    "content:report": "node scripts/content-report.mjs",
    "images": "node scripts/prepare-images.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run content:check && npm run build && npm run test",
    "test:e2e": "npm run build && playwright test",
    "test:lh": "npm run build && lhci autorun"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.4",
    "leaflet": "1.9.4",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "linkedom": "0.18.14",
    "pagefind": "1.5.2",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}

{
  "name": "sito-museo-sergiacomi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Website of the Museo Aldo Sergiacomi (LaDiMAS), prototype.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "content:check": "node scripts/content-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run content:check && npm run build && npm run test"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.4",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "linkedom": "0.18.14",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  }
}

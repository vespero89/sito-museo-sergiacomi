{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs --port 4323 --fake-tiles",
      "startServerReadyPattern": "serve-dist:",
      "url": ["http://127.0.0.1:4323/"],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:4323/$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "document-title": [
              "error",
              {
                "minScore": 1
              }
            ],
            "meta-description": [
              "error",
              {
                "minScore": 1
              }
            ],
            "viewport": [
              "error",
              {
                "minScore": 1
              }
            ],
            "html-has-lang": [
              "error",
              {
                "minScore": 1
              }
            ],
            "canonical": [
              "error",
              {
                "minScore": 1
              }
            ],
            "http-status-code": [
              "error",
              {
                "minScore": 1
              }
            ],
            "link-text": [
              "error",
              {
                "minScore": 1
              }
            ],
            "image-alt": [
              "error",
              {
                "minScore": 1
              }
            ],
            "crawlable-anchors": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}

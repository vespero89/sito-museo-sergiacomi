---
// Label for content that is not confirmed (spec 3.5). Shown in the preview next to a doubtful
// text or in place of a doubtful value. In production it writes nothing: a blocking item stops the
// build, and a non-blocking one is an internal note. Claude Design may restyle it but not remove it.
import { t } from '../i18n/index.ts';
import { mostraAperti } from '../lib/aperti-visibili.ts';

interface Props {
  /** `segnaposto` for provisional or invented content, `da-confermare` for a doubt. */
  tipo?: 'da-confermare' | 'segnaposto';
  /** What is doubtful, in the museum's Italian. */
  motivo?: string;
}
const { tipo = 'da-confermare', motivo } = Astro.props;
const testo =
  tipo === 'segnaposto'
    ? t('daConfermare.segnaposto')
    : motivo
      ? `Da confermare: ${motivo}`
      : 'Da confermare';
const mostra = mostraAperti();
---

{mostra && (
  <span class="da-confermare" data-tipo={tipo}>
    {testo}
  </span>
)}

<style>
  .da-confermare {
    display: inline-block;
    padding: 0.1em 0.5em;
    border: 1px dashed currentColor;
    border-radius: 0.25em;
    font-size: 0.85em;
    font-style: normal;
  }
</style>

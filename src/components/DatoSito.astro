---
// A field of sito.yaml in a page: the value, or the "da confermare" label while the field is
// listed in `daConfermare` (spec 3.5). The IBAN is never printed before it is confirmed. In
// production a doubtful or empty field writes nothing; the page leaves out the row that holds it
// (`sitoDaMostrare`).
import { sitoDaMostrare } from '../lib/aperti-visibili.ts';
import { leggiSito } from '../lib/sito-dati.ts';
import { campoSito } from '../lib/sito.ts';
import DaConfermare from './DaConfermare.astro';

interface Props {
  /** Dotted path in sito.yaml, like `sostegno.iban`. */
  percorso: string;
  /** Show the value as a mail link. */
  email?: boolean;
}
const { percorso, email = false } = Astro.props;
const sito = leggiSito();
const campo = campoSito(sito, percorso);
const mostra = sitoDaMostrare(sito, percorso);
const valore = campo.visibile && typeof campo.valore === 'string' ? campo.valore : '';
---

{!mostra ? null : !campo.visibile ? (
  <DaConfermare motivo={campo.nota} />
) : valore === '' ? (
  <DaConfermare tipo="segnaposto" />
) : email ? (
  <a href={`mailto:${valore}`}>{valore}</a>
) : (
  valore
)}
